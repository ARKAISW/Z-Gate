# =============================================================================
# .env.example — copy to .env and fill in real values
# .env is gitignored; never commit actual secrets
# =============================================================================

# ── Alpaca paper trading credentials ─────────────────────────────────────────
# Generate from: https://alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# MUST be "true" — the system refuses to start if this is not set to exactly "true"
# This is a hard assertion in broker.py, not a soft check.
ALPACA_PAPER=true

# ── LLM providers ────────────────────────────────────────────────────────────
# Primary: Featherless AI (OpenAI-compatible, $25 credit)
# Get key from: https://featherless.ai
FEATHERLESS_API_KEY=your_featherless_key_here
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Fallback 1: Groq (free tier, fast inference)
# Get key from: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Fallback 2: Local Ollama (no key needed, model name only)
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Which provider to try first: featherless | groq | ollama | none
# The system automatically falls back through the chain if the primary fails.
LLM_PROVIDER=featherless

# ── Optional: override config.yaml settings via environment ──────────────────
# Leave commented out to use config.yaml values
# LOG_LEVEL=INFO
# DB_PATH=data/trades.db
